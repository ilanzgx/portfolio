---
import type { CollectionEntry } from "astro:content";
import { getTagIconPath } from "@lib/icons";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const collectionPath = entry.collection === "blog" ? "artigos" : "projetos";
const tags = entry.collection === "projects" ? (entry.data as CollectionEntry<"projects">["data"]).tags : undefined;
---

<a href={`/${collectionPath}/${entry.id}`} class="relative group flex flex-nowrap py-3 px-4 pr-10 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out">
  <div class="flex flex-col flex-1 gap-2">
    <div>
      <div class="font-semibold">
        {entry.data.title}
      </div>
      <div class="text-sm line-clamp-2">
        {entry.data.description}
      </div>
    </div>
    {tags && tags.length > 0 && (
      <ul class="flex flex-wrap gap-1.5">
        {tags.map((tag) => {
          const iconPath = getTagIconPath(tag);
          return (
            <li class="inline-flex items-center gap-1 text-xs rounded-full px-2 py-0.5 border border-black/10 dark:border-white/15 text-black/50 dark:text-white/60">
              {iconPath && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-3 fill-current shrink-0">
                  <path d={iconPath} />
                </svg>
              )}
              {tag}
            </li>
          );
        })}
      </ul>
    )}
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current">
    <line x1="5" y1="12" x2="19" y2="12" class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out" />
    <polyline points="12 5 19 12 12 19" class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out" />
  </svg>
</a>
